# Скопируйте в .env.local и заполните. Никогда не коммитьте .env.local.

# База данных. Локально — файл SQLite; в облаке — Turso (libsql://...).
DATABASE_URL=file:data/qalqan.db
DATABASE_AUTH_TOKEN=

# LLM для уточнения анализа (этап 2). Без ключа работает только движок правил.
ANTHROPIC_API_KEY=
QALQAN_LLM_MODEL=claude-haiku-5-5
QALQAN_LLM_TIMEOUT_MS=6000

# Пароль панели антифрода (HTTP Basic, логин любой). Пусто — панель открыта (режим демо).
QALQAN_DASHBOARD_PASSWORD=
